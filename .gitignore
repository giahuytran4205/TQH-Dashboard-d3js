# =============================================================================
# Project document workflow
# =============================================================================

# Keep source documents and editable LaTeX files:
# - docs/report_docx/report.docx
# - docs/report_md/report.md
# - docs/report_latex/main.tex
# - docs/report_latex/domain_tasks/*.tex
# - docs/report_latex/images/*

# Ignore temporary Office lock files
~$*.docx
*.tmp


# =============================================================================
# LaTeX build artifacts
# =============================================================================

# Ignore LaTeX auxiliary files anywhere in the project
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.xdv
*.dvi
*.ps

# Ignore LaTeX intermediate files
*.ilg
*.ind
*.idx
*.ist
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls

# Ignore latexmk generated files
*.latexmain
*.synctex\(busy\)

# Ignore generated PDFs from LaTeX builds
docs/report_latex/*.pdf
docs/report_latex/domain_tasks/*.pdf

# If you later generate compiled PDFs elsewhere under docs, uncomment:
# docs/**/*.pdf


# =============================================================================
# Pandoc / conversion leftovers
# =============================================================================

# Pandoc sometimes creates extracted media folders.
# Keep your intended images folder, but ignore accidental media folders.
media/
docs/report_md/media/
docs/report_docx/media/

# Temporary converted files
*.bak
*.backup
*.old

.claude